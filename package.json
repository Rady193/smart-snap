{
  "name": "smart-snap",
  "productName": "Smart Snap",
  "version": "1.2.1",
  "description": "Screenshots that remember where they came from, collected into a PDF report",
  "author": "SCAFFApps",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Rady193/smart-snap",
  "repository": "github:Rady193/smart-snap",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.scaffapps.smartsnap",
    "productName": "Smart Snap",
    "copyright": "Copyright © 2026 SCAFFApps",
    "files": [
      "main.js",
      "registration.js",
      "releases.js",
      "registration-preload.js",
      "preload.js",
      "overlay-preload.js",
      "windows.ps1",
      "printscreen.ps1",
      "app/**"
    ],
    "publish": null,
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "afterPack": "build/after-pack.js",
    "afterAllArtifactBuild": "build/keep-latest.js",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Snap",
      "artifactName": "Smart-Snap-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "menuCategory": "SCAFFApps",
      "differentialPackage": false
    }
  }
}
